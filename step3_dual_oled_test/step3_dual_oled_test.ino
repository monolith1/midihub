/*
 * ==============================================================================
 * Step 3: Dual 0.96" I2C OLED Hardware Test (Zero-Jumper Mod, Pure Self-Contained)
 * ==============================================================================
 * 
 * Wire Hookup:
 * 
 *   SCREEN 1 (Left - Parameters / HUD):
 *     GND ──► ESP32 GND
 *     VCC ──► ESP32 3V3
 *     SCL ──► ESP32 GPIO 12  (I2C Bus 0)
 *     SDA ──► ESP32 GPIO 11  (I2C Bus 0)
 * 
 *   SCREEN 2 (Right - Visualizer / Waves):
 *     GND ──► ESP32 GND
 *     VCC ──► ESP32 3V3
 *     SCL ──► ESP32 GPIO 9   (I2C Bus 1)
 *     SDA ──► ESP32 GPIO 10  (I2C Bus 1)
 * 
 * Both screens stay at factory default address 0x3C!
 * No external libraries needed: Native I2C + SSD1306 framebuffer included!
 */

#include <Arduino.h>
#include <Wire.h>

