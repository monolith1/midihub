#define OLED_WIDTH 128
#define OLED_HEIGHT 64

// Screen 1: Bus 0 (Wire)
#define S1_SDA 11
#define S1_SCL 12

// Screen 2: Bus 1 (Wire1)
#define S2_SDA 10
#define S2_SCL 9

// Framebuffers (128x64 / 8 = 1024 bytes each)
